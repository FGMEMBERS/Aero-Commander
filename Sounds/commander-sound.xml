<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList>

  <fx>

    <!-- Engine 1 -->
    <crank>
      <name>engstart1</name>
      <path>start.wav</path>
      <property>engines/engine[0]/cranking</property>
      <volume>
        <offset>0.4</offset>
      </volume>
      <reference-dist>100</reference-dist>
      <max-dist>1000</max-dist>
    </crank>

    <crank>
      <name>crank1</name>
      <mode>looped</mode>
      <path>Sounds/cranking.wav</path>
      <condition>
        <property>engines/engine[0]/cranking</property>
        <not>
          <property>engines/engine[0]/running</property>
        </not>
      </condition>
      <volume>
        <offset>0.5</offset>
      </volume>
      <reference-dist>100</reference-dist>
      <max-dist>1000</max-dist>
    </crank>

    <crank>
      <name>cough1</name>
      <path>Sounds/coughing.wav</path>
      <property>engines/engine[0]/running</property>
      <volume>
        <offset>0.3</offset>
      </volume>
      <reference-dist>100</reference-dist>
      <max-dist>1000</max-dist>
    </crank>

    <engine>
      <name>engine1</name>
      <mode>looped</mode>
      <path>engine.wav</path>
      <property>engines/engine[0]/running</property>
      <volume>
        <property>engines/engine[0]/mp-osi</property>
        <factor>0.00375</factor>
        <min>0.25</min>
        <max>0.75</max>
      </volume>
      <volume>
        <property>orientation/alpha-deg</property>
        <type>log</type>
        <min>1.0</min>
        <max>1.5</max>
      </volume>
      <volume>
        <property>sim/current-view/internal</property>
        <offset>1.0</offset>
        <factor>-0.5</factor>
      </volume>
      <pitch>
        <property>engines/engine[0]/rpm</property>
        <factor>0.0004</factor>
        <min>0.5</min>
        <max>2.3</max>
        <offset>0.25</offset>
      </pitch>
      <reference-dist>100</reference-dist>
      <max-dist>1000</max-dist>
    </engine>

    <propeller>
      <name>propeller1</name>
      <mode>looped</mode>
      <path>propeller.wav</path>
      <property>engines/engine[0]/running</property>
      <volume>
        <property>orientation/alpha-deg</property>
        <type>log</type>
        <min>0.2</min>
        <max>1.0</max>
      </volume>
      <volume>
        <property>sim/current-view/internal</property>
        <factor>0.5</factor>
      </volume>
      <pitch>
        <property>engines/engine[0]/mp-osi</property>
        <factor>0.0036</factor>
        <min>0.5</min>
        <max>2.0</max>
        <offset>0.9</offset>
      </pitch>
      <reference-dist>100</reference-dist>
      <max-dist>1000</max-dist>
    </propeller>

    <!-- Engine 2 -->
    <crank>
      <name>engstart2</name>
      <path>start.wav</path>
      <property>engines/engine[1]/cranking</property>
      <volume>
        <offset>0.4</offset>
      </volume>
      <reference-dist>100</reference-dist>
      <max-dist>1000</max-dist>
    </crank>

    <crank>
      <name>crank2</name>
      <mode>looped</mode>
      <path>Sounds/cranking.wav</path>
      <condition>
        <property>engines/engine[1]/cranking</property>
        <not>
          <property>engines/engine[1]/running</property>
        </not>
      </condition>
      <volume>
        <offset>0.5</offset>
      </volume>
      <reference-dist>100</reference-dist>
      <max-dist>1000</max-dist>
    </crank>

    <crank>
      <name>cough2</name>
      <path>Sounds/coughing.wav</path>
      <property>engines/engine[1]/running</property>
      <volume>
        <offset>0.3</offset>
      </volume>
      <reference-dist>100</reference-dist>
      <max-dist>1000</max-dist>
    </crank>

    <engine>
      <name>engine2</name>
      <mode>looped</mode>
      <path>engine.wav</path>
      <property>engines/engine[1]/running</property>
      <volume>
        <property>engines/engine[1]/mp-osi</property>
        <factor>0.00375</factor>
        <min>0.25</min>
        <max>0.75</max>
      </volume>
      <volume>
        <property>orientation/alpha-deg</property>
        <type>log</type>
        <min>1.0</min>
        <max>1.5</max>
      </volume>
      <volume>
        <property>sim/current-view/internal</property>
        <offset>1.0</offset>
        <factor>-0.5</factor>
      </volume>
      <pitch>
        <property>engines/engine[1]/rpm</property>
        <factor>0.0004</factor>
        <min>0.5</min>
        <max>2.3</max>
        <offset>0.25</offset>
      </pitch>
      <reference-dist>100</reference-dist>
      <max-dist>1000</max-dist>
    </engine>

    <propeller>
      <name>propeller2</name>
      <mode>looped</mode>
      <path>propeller.wav</path>
      <property>engines/engine[1]/running</property>
      <volume>
        <property>orientation/alpha-deg</property>
        <type>log</type>
        <min>0.2</min>
        <max>1.0</max>
      </volume>
      <volume>
        <property>sim/current-view/internal</property>
        <factor>0.5</factor>
      </volume>
      <pitch>
        <property>engines/engine[1]/mp-osi</property>
        <factor>0.0036</factor>
        <min>0.5</min>
        <max>2.0</max>
        <offset>0.9</offset>
      </pitch>
      <reference-dist>100</reference-dist>
      <max-dist>1000</max-dist>
    </propeller>

    <!-- ************************************************************ -->
    <rumble>
      <name>rumble</name>
      <mode>looped</mode>
      <path>Sounds/rumble.wav</path>
      <condition>
        <or>
          <property>/gear/gear[0]/wow</property>
          <property>/gear/gear[1]/wow</property>
          <property>/gear/gear[2]/wow</property>
        </or>
      </condition>
      <volume>
        <property>/velocities/airspeed-kt</property>
        <type>log</type>
        <factor>0.5</factor>
      </volume>
    </rumble>

    <gear>
      <name>gear</name>
      <mode>in-transit</mode>
      <path>Sounds/gear.wav</path>
      <property>/gear/gear[0]/position-norm</property>
      <pitch>
        <internal>dt_play</internal>
        <offset>1.0</offset>
        <factor>-0.001</factor>
      </pitch>
    </gear>

    <gear>
      <name>gear-lock</name>
      <path>Sounds/gear-lck.wav</path>
      <condition>
        <greather-than>
          <property>/gear/gear[0]/position-norm</property>
          <value>0.01</value>
        </greather-than>
        <less-than>
          <property>/gear/gear[0]/position-norm</property>
          <value>0.1</value>
        </less-than>
      </condition>
    </gear>

    <squeal>
      <name>squeal</name>
      <path>Sounds/squeal.wav</path>
      <condition>
        <or>
          <property>/gear/gear[0]/wow</property>
          <property>/gear/gear[1]/wow</property>
          <property>/gear/gear[2]/wow</property>
        </or>
      </condition>
      <volume>
        <property>/velocities/speed-down-fps</property>
        <factor>0.05</factor>
        <min>0.1</min>
      </volume>
      <volume>
        <property>/velocities/airspeed-kt</property>
        <factor>0.01</factor>
        <offset>0.4</offset>
      </volume>
      <pitch>
        <offset>1.25</offset>
      </pitch>
    </squeal>

    <flap>
      <name>flaps</name>
      <mode>in-transit</mode>
      <path>flaps.wav</path>
      <property>/surface-positions/flap-pos-norm</property>
      <volume>
        <offset>0.25</offset>
      </volume>
    </flap>

    <wind>
      <name>wind</name>
      <mode>looped</mode>
      <path>Sounds/wind.wav</path>
      <property>/velocities/airspeed-kt</property>
      <volume>
        <property>/position/altitude-ft</property>
        <factor>-0.000015</factor>
        <offset>1.0</offset>
        <min>0.1</min>
        <max>1.0</max>
      </volume>
      <volume>
        <property>/velocities/airspeed-kt</property>
        <factor>0.0015</factor>
        <min>0.03</min>
        <max>0.25</max>
      </volume>
      <pitch>
        <property>/velocities/airspeed-kt</property>
        <factor>0.01</factor>
        <offset>1.25</offset>
      </pitch>
    </wind>

    <stall>
      <name>stall</name>
      <path>Sounds/stall.wav</path>
      <property>/sim/aero/alarms/stall-warning</property>
      <volume>
        <property>/velocities/airspeed-kt</property>
        <min>30.0</min>
      </volume>
    </stall>

    <click>
      <name>Nav Lights ON</name>
      <path>click.wav</path>
      <condition>
        <property>controls/lighting/nav-lights</property>
      </condition>
      <volume>
        <factor>0.6</factor>
      </volume>
    </click>

    <click>
      <name>Nav Lights OFF</name>
      <path>click.wav</path>
      <condition>
        <not>
          <property>controls/lighting/nav-lights</property>
        </not>
      </condition>
      <volume>
        <factor>0.6</factor>
      </volume>
    </click>

    <click>
      <name>Land Lights ON</name>
      <path>click.wav</path>
      <condition>
        <property>/controls/lighting/landing-lights</property>
      </condition>
      <volume>
        <factor>0.6</factor>
      </volume>
    </click>

    <click>
      <name>Land Lights OFF</name>
      <path>click.wav</path>
      <condition>
        <not>
          <property>/controls/lighting/landing-lights</property>
        </not>
      </condition>
      <volume>
        <factor>0.6</factor>
      </volume>
    </click>

    <click>
      <name>Instr Lights ON</name>
      <path>click.wav</path>
      <condition>
        <property>/controls/lighting/instrument-lights</property>
      </condition>
      <volume>
        <factor>0.6</factor>
      </volume>
    </click>

    <click>
      <name>Instr Lights OFF</name>
      <path>click.wav</path>
      <condition>
        <not>
          <property>/controls/lighting/instrument-lights</property>
        </not>
      </condition>
      <volume>
        <factor>0.6</factor>
      </volume>
    </click>

    <kap140-disengage>
      <name>KAP140 disengage</name>
      <path>kap140-disengage.wav</path>
      <condition>
        <or>
          <equals>
            <property>autopilot/kap140/panel/state</property>
            <value>3</value>
          </equals>
          <property>autopilot/kap140/panel/ap-timer</property>
        </or>
      </condition>
      <volume><factor>0.2</factor></volume>
      <position>
        <x>-0.444</x>
        <y> 0.229</y>
        <z> 0.312</z>
      </position>
    </kap140-disengage>

    <kap140-alert>
      <name>KAP140 altitude alerter</name>
      <path>kap140-alert.wav</path>
      <condition>
        <property>autopilot/kap140/panel/alt-alert-sound</property>
      </condition>
      <volume><factor>0.2</factor></volume>
      <position>
        <x>-0.444</x>
        <y> 0.229</y>
        <z> 0.312</z>
      </position>
    </kap140-alert>

    <!-- DOOR -->
    <door>
      <name>Left frontdoor open</name>
      <path>DoorOpen.wav</path>
      <condition>
        <greater-than>
          <property>sim/model/door-positions/crew/position-norm</property>
          <value>0.1</value>
        </greater-than>
      </condition>
      <volume>
        <factor>0.8</factor>
      </volume>
    </door>

    <door>
      <name>Left frontdoor close</name>
      <path>DoorClosed.wav</path>
      <condition>
        <equals>
          <property>sim/model/door-positions/crew/position-norm</property>
          <value>0</value>
        </equals>
      </condition>
      <volume>
        <factor>1</factor>
      </volume>
    </door>

    <door>
      <name>Left reardoor open</name>
      <path>DoorOpen.wav</path>
      <condition>
        <greater-than>
          <property>sim/model/door-positions/passenger/position-norm</property>
          <value>0.1</value>
        </greater-than>
      </condition>
      <volume>
        <factor>0.8</factor>
      </volume>
    </door>

    <door>
      <name>Left reardoor close</name>
      <path>DoorClosed.wav</path>
      <condition>
        <equals>
          <property>sim/model/door-positions/passenger/position-norm</property>
          <value>0</value>
        </equals>
      </condition>
      <volume>
        <factor>1</factor>
      </volume>
    </door>

    <door>
      <name>Left cargodoor open</name>
      <path>DoorOpen.wav</path>
      <condition>
        <greater-than>
          <property>sim/model/door-positions/cargo/position-norm</property>
          <value>0.1</value>
        </greater-than>
      </condition>
      <volume>
        <factor>0.8</factor>
      </volume>
    </door>

    <door>
      <name>Left cargodoor close</name>
      <path>DoorClosed.wav</path>
      <condition>
        <equals>
          <property>sim/model/door-positions/cargo/position-norm</property>
          <value>0</value>
        </equals>
      </condition>
      <volume>
        <factor>1</factor>
      </volume>
    </door>

    <rain>
      <name>rain</name>
      <mode>looped</mode>
      <path>rain.wav</path>
      <condition>
        <greater-than>
          <property>environment/metar/rain-norm</property>
          <value>0.2</value>
        </greater-than>
      </condition>
      <volume>
        <property>environment/metar/rain-norm</property>
        <factor>1.00</factor>
        <offset>0.00</offset>
        <min>0.4</min>
        <max>0.9</max>
      </volume>
      <pitch>
        <property>velocities/airspeed-kt</property>
        <factor>0.001</factor>
        <offset>1.0</offset>
      </pitch>
      <reference-dist>100</reference-dist>
      <max-dist>1000</max-dist>
    </rain>

  </fx>

</PropertyList>
