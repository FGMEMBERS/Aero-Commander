<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList>

  <path>interior.ac</path>

  <animation>
    <!-- Objets opaques -->
    <object-name>interieur</object-name>
    <object-name>inttour</object-name>
    <object-name>planchet</object-name>
    <object-name>intportecrew</object-name>
    <object-name>intportecrew2</object-name>
    <object-name>intportemain</object-name>
    <object-name>intportecargo</object-name>
    <object-name>Ceniceros</object-name>
    <object-name>carte1</object-name>
    <object-name>carte2</object-name>
    <object-name>courbe</object-name>

    <!-- Objets transparents -->
    <object-name>intvitres</object-name>
    <object-name>intvitrecrew</object-name>
    <object-name>intvitremain</object-name>
    <object-name>paresoleil</object-name>
    <!-- HDR mode -->
    <object-name>HDRintvitres</object-name>
    <object-name>HDRintvitrecrew</object-name>
    <object-name>HDRintvitremain</object-name>
    <object-name>HDRparesoleil</object-name>
  </animation>

  <!-- working for Rembrandt -->
  <effect>
    <inherits-from>../Effects/Glass/glassrain</inherits-from>
    <object-name>intvitres</object-name>
    <object-name>intvitrecrew</object-name>
    <object-name>intvitremain</object-name>
    <object-name>paresoleil</object-name>
  </effect>

  <effect>
    <inherits-from>../Effects/Glass/glass</inherits-from>
    <object-name>HDRintvitres</object-name>
    <object-name>HDRintvitrecrew</object-name>
    <object-name>HDRintvitremain</object-name>
    <object-name>HDRparesoleil</object-name>
  </effect>

  <!-- Sélection des vitres en fonction de HDR ou pas -->
  <animation>
    <type>select</type>
    <condition>
      <property>/sim/rendering/hdr/hdr-enabled</property>
    </condition>
    <object-name>HDRintvitres</object-name>
    <object-name>HDRintvitrecrew</object-name>
    <object-name>HDRintvitremain</object-name>
    <object-name>HDRparesoleil</object-name>
  </animation>

  <animation>
    <type>select</type>
    <condition>
      <not><property>/sim/rendering/hdr/hdr-enabled</property></not>
    </condition>
    <object-name>intvitres</object-name>
    <object-name>intvitrecrew</object-name>
    <object-name>intvitremain</object-name>
    <object-name>paresoleil</object-name>
  </animation>

  <model>
    <path>Panel/all-panel.xml</path>
  </model>

  <model>
    <path>Panel/Overhead/all-overheads.xml</path>
  </model>

  <model>
    <path>../Pilot/all-pilots.xml</path>
  </model>

  <model>
    <path>Seats/all-seats.xml</path>
  </model>

  <model>
    <path>Panel/Instruments/Pedals/all-pedals.xml</path>
  </model>

  <model>
    <path>Panel/Instruments/Yokes/all-yokes.xml</path>
  </model>

  <model>
    <path>Panel/Instruments/MagneticCompass/all-MagneticCompass.xml</path>
  </model>

  <!-- Les portes -->
  <animation>
    <name>IntPorteCrew</name>
    <object-name>intportecrew</object-name>
    <object-name>intvitrecrew</object-name>
    <object-name>intportecrew2</object-name>
  </animation>

  <animation>
    <type>pick</type>
    <object-name>IntPorteCrew</object-name>
    <object-name>HDRintvitrecrew</object-name>
    <visible>true</visible>
    <action>
      <button>0</button>
      <repeatable>false</repeatable>
      <binding>
        <condition>
          <and>
            <property>/gear/gear[0]/wow</property>
            <property>/gear/gear[1]/wow</property>
            <property>/gear/gear[2]/wow</property>
            <less-than>
              <property>/gear/gear[0]/rollspeed-ms</property>
              <value>10</value>
            </less-than>
          </and>
        </condition>
        <command>nasal</command>
        <script>doors.crew.toggle();</script>
      </binding>
    </action>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>IntPorteCrew</object-name>
    <object-name>HDRintvitrecrew</object-name>
    <property>sim/model/door-positions/crew/position-norm</property>
    <factor> -70 </factor>
    <axis>
      <x1-m> -3.44836 </x1-m>
      <y1-m> -0.70331 </y1-m>
      <z1-m> -1.50346 </z1-m>
      <x2-m> -3.44828 </x2-m>
      <y2-m> -0.68191 </y2-m>
      <z2-m> -1.05300 </z2-m>
    </axis>
  </animation>

  <animation>
    <name>IntPorteMain</name>
    <object-name>intportemain</object-name>
    <object-name>intvitremain</object-name>
  </animation>

  <animation>
    <type>pick</type>
    <object-name>IntPorteMain</object-name>
    <object-name>HDRintvitremain</object-name>
    <visible>true</visible>
    <action>
      <button>0</button>
      <repeatable>false</repeatable>
      <binding>
        <condition>
          <and>
            <property>/gear/gear[0]/wow</property>
            <property>/gear/gear[1]/wow</property>
            <property>/gear/gear[2]/wow</property>
            <less-than>
              <property>/gear/gear[0]/rollspeed-ms</property>
              <value>10</value>
            </less-than>
          </and>
        </condition>
        <command>nasal</command>
        <script>doors.passenger.toggle();</script>
      </binding>
    </action>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>IntPorteMain</object-name>
    <object-name>HDRintvitremain</object-name>
    <property>sim/model/door-positions/passenger/position-norm</property>
    <factor> -70 </factor>
    <axis>
      <x1-m> -1.89243 </x1-m>
      <y1-m> -0.70331 </y1-m>
      <z1-m> -1.50346 </z1-m>
      <x2-m> -1.89234 </x2-m>
      <y2-m> -0.68141 </y2-m>
      <z2-m> -1.01734 </z2-m>
    </axis>
  </animation>

  <animation>
    <name>IntPorteCargo</name>
    <object-name>intportecargo</object-name>
  </animation>

  <animation>
    <type>pick</type>
    <object-name>IntPorteCargo</object-name>
    <visible>true</visible>
    <action>
      <button>0</button>
      <repeatable>false</repeatable>
      <binding>
        <condition>
          <and>
            <property>/gear/gear[0]/wow</property>
            <property>/gear/gear[1]/wow</property>
            <property>/gear/gear[2]/wow</property>
            <less-than>
              <property>/gear/gear[0]/rollspeed-ms</property>
              <value>10</value>
            </less-than>
          </and>
        </condition>
        <command>nasal</command>
        <script>doors.cargo.toggle();</script>
      </binding>
    </action>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>IntPorteCargo</object-name>
    <property>sim/model/door-positions/cargo/position-norm</property>
    <factor> -90 </factor>
    <axis>
      <x1-m> -0.81399 </x1-m>
      <y1-m> -0.67472 </y1-m>
      <z1-m> -1.07995 </z1-m>
      <x2-m> -0.38148 </x2-m>
      <y2-m> -0.67188 </y2-m>
      <z2-m> -1.07995 </z2-m>
    </axis>
  </animation>

</PropertyList>
